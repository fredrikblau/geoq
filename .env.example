# Required for chat responses
GEMINI_API_KEY=

# City pack identity (change these when adapting Geoq to another city)
GEOQ_NAME=جعوک
GEOQ_REGION=قشم
GEOQ_SUPPORTED_AREAS=جزیره قشم، هرمز، لارک، هنگام و جزیره ناز
GEOQ_OFFICIAL_URL=geoq.ir
GEOQ_CREATOR_TEXT=من توسط ساکنان محلی ساخته شده‌ام.

# Optional local services
REDIS_URL=redis://localhost:6379/0
CHROMA_DIR=qeshm_db
EMBED_MODEL=intfloat/multilingual-e5-large
RERANKER_ID=jinaai/jina-reranker-v2-base-multilingual

# Server
PORT=8001
CORS_ORIGINS=http://localhost:3000
MAX_CONTEXT_CHARS=3500
MAX_HISTORY_LEN=20
